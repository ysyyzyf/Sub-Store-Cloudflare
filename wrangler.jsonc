{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "sub-store",
    "main": "worker-rs/build/worker/shim.mjs",
    "compatibility_date": "2026-05-07",
    "build": {
        "command": "bash scripts/build-worker-cf.sh"
    },
    "vars": {
        "SUB_STORE_BACKEND_VERSION": "upstream-latest",
        "SUB_STORE_CLOUDFLARE_VERSION": "26.45.0"
    },
    "secrets_store_secrets": [
        {
            "binding": "JWT_SECRET_STORE",
            "store_id": "3ae858952e0744bfb04d0aff2a6c81df",
            "secret_name": "clsyyy815"
        }
    ],
    "d1_databases": [
        {
            "binding": "SUB_STORE_DB",
            "database_name": "sub-store-cf-d1",
            "database_id": "ed905a24-c262-40d9-9afa-3bd7ec67d4ab",
            "migrations_dir": "migrations"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "SUB_STORE_CACHE",
            "id": "8105b5e40da94fc6a73a5adae00a4535"
        }
    ],
    "r2_buckets": [
        {
            "binding": "SUB_STORE_BACKUP",
            "bucket_name": "sub-store-backups"
        }
    ],
    "queues": {
        "producers": [
            {
                "binding": "REFRESH_QUEUE",
                "queue": "sub-store-refresh"
            }
        ],
        "consumers": [
            {
                "queue": "sub-store-refresh",
                "max_batch_size": 10,
                "max_batch_timeout": 30
            }
        ]
    },
    "analytics_engine_datasets": [
        {
            "binding": "sub-store-cf-ana-eng",
            "dataset": "sub-store-cf"
        }
    ],
    "triggers": {
        "crons": [
            "28 23 * * *",
            "16 9 * * *"
        ]
    },
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": false,
            "head_sampling_rate": 0
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0
        }
    }
}
